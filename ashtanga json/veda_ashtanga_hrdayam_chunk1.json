  "foundational_concepts": {
    "definition_of_ayu": {
      "sanskrit": "शरीरेन्द्रियसत्वात्मसंयोगो धारि जीवितम् । नित्यगश्चानुबन्धश्च पर्यायैरायुरुच्यते ।।",
      "source_ref": "C.S.Sū. 1:41",
      "english": "Life is the combination of body (śarīra), sense organs (indriya), mind (sattva/manas), and soul (ātma). As long as these four are combined, life exists.",
      "synonyms": {
        "dharī": "That which prevents the body from decay",
        "jīvitam": "That which keeps alive",
        "nityagam": "That which serves as permanent substratum of the body",
        "anubandham": "That which transmigrates from one body to another"
      }
    },
    "definition_of_ayurveda": {
      "sanskrit": "आयुरनेन वेति इत्यायुर्वेदः",
      "source_ref": "Śabdakalpadruma",
      "english": "The science or knowledge of life. Āyu = life; vetti = science or knowledge.",
      "purpose": ["Dharma (righteous conduct)", "Artha (ethical acquisition of wealth)", "Kāma (lawful fulfilment of desire)", "Mokṣa (liberation/ultimate aim)"]
    },
    "definition_of_health": {
      "english": "Equilibrium state of the three doṣas (vāta, pitta, kapha) along with seven dhātus, three malas, and power of digestion, combined with pleasant mind, soul, and sense organs.",
      "definition_of_disease": "Vitiation of the doṣas."
    },
