    {
      "id": "form_024",
      "name": "Piccha Basti (Slimy Enema for Pittaja Atisara)",
      "type": "basti (enema) — piccha (slimy)",
      "ingredients": [
        {
          "herb_name": "salmali flower stalks",
          "quantity": "bolus 40 gm",
          "form": "roasted and pounded, pressed in milk"
        },
        {
          "herb_name": "boiled milk",
          "quantity": "",
          "form": "liquid medium"
        },
        {
          "herb_name": "tila oil",
          "quantity": "640 gm",
          "form": "oil"
        },
        {
          "herb_name": "ghee",
          "quantity": "640 gm",
          "form": "fat"
        },
        {
          "herb_name": "madhuka paste",
          "quantity": "adequate quantity",
          "form": "paste"
        }
      ],
      "preparation_method": "Fresh flower-stalks of salmali wrapped in fresh kusa grass, plastered with black earth, heated on cow-dung fire until dry. Stalks taken out, pounded, bolus 40 gm pressed in boiled milk and filtered. Mixed with tila oil 640 gm and ghee 640 gm, added with madhuka paste in adequate quantity",
      "indications": ["pittaja diarrhoea (advanced)", "fever", "oedema", "gulma", "chronic diarrhoea", "grahani disorder"],
      "dosage": "enema administration",
      "anupana": "milk or meat-soup of wild animals after",
      "contraindications": [],
      "source": {
        "text": "Charaka Samhita",
